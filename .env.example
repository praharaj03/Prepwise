# Vapi: browser-safe public key only
NEXT_PUBLIC_VAPI_WEB_TOKEN=
NEXT_PUBLIC_VAPI_GENERATION_ASSISTANT_ID=
# Optional: leave blank to use the built-in practice interviewer
NEXT_PUBLIC_VAPI_INTERVIEW_ASSISTANT_ID=

# Groq: server only; required for adaptive AI interviews, optional for solo mode
GROQ_API_KEY=
# Optional override; defaults to openai/gpt-oss-20b
GROQ_INTERVIEW_MODEL=

# Firebase web app: copy from Project settings > Your apps > Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional for Authentication / Firestore
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Firebase Admin: server only; must use the same project as the web app
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""
